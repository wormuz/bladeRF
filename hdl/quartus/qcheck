#!/usr/bin/env python3
"""Static check for every defect class that has cost a build in this repo.

Runs in under a second and needs no Quartus. Every rule here exists because
the same mistake shipped, the build died or lied, and the day went into
finding it again. The point is to never spend that day twice.

    qcheck            check the working tree
    qcheck --list     explain each rule and the build it cost

Exit 1 if anything fires.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]

# Every SDC the hosted revision actually reads, not just the one we edit.
# The same defect classes can sit in the ones we inherited: they are read by
# the same read_sdc pass, and a fatal message or an unbound exception in any
# of them costs exactly as much.
SDCS = [
    ROOT / "hdl/fpga/platforms/bladerf-micro/constraints/bladerf.sdc",
    ROOT / "hdl/fpga/platforms/bladerf-micro/constraints/spi.sdc",
    ROOT / "hdl/fpga/platforms/bladerf-micro/constraints/i2c.sdc",
    ROOT / "hdl/fpga/platforms/common/bladerf/constraints/ad9361.sdc",
    ROOT / "hdl/fpga/platforms/common/bladerf/constraints/fx3.sdc",
]
SDC = SDCS[0]
HOSTED = ROOT / "hdl/fpga/platforms/bladerf-micro/vhdl/bladerf-hosted.vhd"
HEADERS = list((ROOT / "fpga_common/include").glob("*.h"))

findings = []


def fail(rule, detail, cost):
    findings.append((rule, detail, cost))


def code_only(text, comment="#"):
    """Strip comments so a rule cannot fire on its own explanation."""
    return "\n".join(l.split(comment)[0] for l in text.split("\n"))


# ---------------------------------------------------------------- SDC rules

def check_all_sdcs():
    """Rules that apply to any SDC the build reads, ours or inherited.

    A fatal message or an exception spanning instances costs the same
    whichever file it sits in -- read_sdc processes them in one pass.
    """
    for f in SDCS:
        if not f.exists():
            continue
        src = code_only(f.read_text())

        if re.search(r"post_message\s+-type\s+error", src):
            fail("sdc-fatal-message",
                 f"{f.name}: post_message -type error aborts read_sdc; every "
                 "later constraint is discarded, in every file",
                 "one build reported a bogus 'Can't fit design'")

        pair = re.compile(
            r"(set_false_path|set_max_skew|set_net_delay|set_multicycle_path"
            r"|set_max_delay|set_min_delay)\b[^\n]*?"
            r"-from[^\n]*?\{\s*(\*[^\}]*)\}[^\n]*?-to[^\n]*?\{\s*(\*[^\}]*)\}")
        inst = re.compile(r"[A-Za-z_]\w*:[A-Za-z_]\w*\|")
        for m in pair.finditer(src):
            if not inst.search(m.group(2)) and not inst.search(m.group(3)):
                fail("sdc-unpinned-pair",
                     f"{f.name}: {m.group(1)} -from {{{m.group(2)}}} "
                     f"-to {{{m.group(3)}}} spans instances",
                     "shipped three times; each cost a build")
                break


def check_sdc():
    if not SDC.exists():
        return
    raw = SDC.read_text()
    src = code_only(raw)

    # Rules 1 and 2 (fatal message, unpinned pair) moved to
    # check_all_sdcs: they apply to every SDC the build reads, not only
    # the one we wrote.

    # 3. A false path takes the skew and net-delay bounds down with it: the
    #    following set_max_skew is reported "No path is found" and dropped,
    #    leaving a held-data bus with no bound on bit-to-bit skew.
    for m in re.finditer(r"set_false_path\s+-from\s+\$(\w+)\s+-to\s+\$(\w+)", src):
        fail("sdc-false-path-on-bundle",
             f"set_false_path -from ${m.group(1)} -to ${m.group(2)}: use "
             "set_max_delay 100 / set_min_delay -100 with both ends instead, "
             "or the skew bound on the same pair is silently dropped",
             "left five crossings physically unbounded")
        break

    # 4. A source-only relaxation reaches past the crossing.
    if re.search(r"set_(max|min)_delay\s+-?\d+\s+-from\s+\$?\w+\s*(\n|$)", src):
        fail("sdc-source-only-relaxation",
             "set_max_delay/set_min_delay with -from but no -to reaches every "
             "fanout of the source",
             "overrode the SPI and I2C multicycles: eight violations to -14.061 ns")

    # 5. Tcl regexp against Quartus hierarchy names: they contain backslashes
    #    from VHDL generate labels, and a backslash in a regexp is an escape,
    #    so a pattern that reads correctly matches nothing.
    if re.search(r"regexp\s+\{[^}]*\\\|", src):
        fail("sdc-regexp-on-hierarchy",
             "regexp against a hierarchy name: \\fifo_gen: style labels make "
             "it match nothing. Split on the separator instead",
             "dcfifo pointers bound to zero instances")

    # 6a. An unanchored node pattern picks up deeper namesakes. Both rdptr_g
    #     and a_graycounter_*:rdptr_g1p exist in every FIFO, and only the
    #     first feeds the synchroniser; "*rdptr_g*" takes both. Preferring
    #     the wrong one bound five instances to a register with no
    #     destination clock.
    #     The order in a fallback list is what matters: whichever pattern is
    #     tried first wins, so a wildcard variant ahead of the anchored one
    #     silently takes precedence.
    for m in re.finditer(r"first_nonempty\s+\$\w+\s+\{([^}]*)\}", src):
        alts = [a for a in m.group(1).split() if re.search(r"(rd|wr)ptr_g", a)]
        if not alts:
            continue
        # The first alternative decides, because first_nonempty stops there.
        # It must be anchored -- no leading wildcard -- or it also matches
        # the deeper namesakes and the intended register is never reached.
        if alts[0].startswith("*"):
            fail("sdc-unanchored-node-name",
                 f"'{alts[0]}' is tried first and starts with a wildcard, so "
                 "it also matches the deeper namesakes "
                 "(a_graycounter_*:...g1p, a_gray2bin_*:...g_gray2bin). "
                 "Anchor the first alternative on the exact form the fitter "
                 "reports",
                 "five FIFOs lost their net-delay bound; "
                 "warning 17897 went from 2 to 7")
            break

    # NOT a rule: "is this entity instantiated in this revision".
    #
    # Written, then withdrawn after two rounds of false positives. There is no
    # complete static list of what gets built: bladerf-hosted.vhd covers the
    # top level, nios_system.tcl covers Qsys, and ad_iqcor is in neither
    # because it comes from the ADI IP tree -- yet it appears 672 times in the
    # netlist. Adding sources until the false positive goes away is fitting
    # the rule to the answer, not checking anything.
    #
    # vctcxo_tamer, the case that motivated it, was caught by the count check
    # instead: constraints for an absent entity bind zero instances and the
    # block says so. That check works from the build's own report and needs no
    # guess about what the build contains.

    # 6c. Constraining a crossing that vendor IP already cuts. The dcfifo
    #     megafunction emits its own set_false_path on rdptr_g -> ws_dgrp and
    #     delayed_wrptr_g -> rs_dgwp, twenty of them, from inside the
    #     generated IP. Anything layered on top has no path to attach to and
    #     is dropped with "No path is found" -- which reads like a broken
    #     pattern and is not.
    #     The tell is a call to the vendor pointer procedures at all: their
    #     whole purpose is to constrain crossings the IP has already cut.
    m = re.search(r"apply_sdc_(mw_)?dcfifo_(for_ptrs|mstable_delay)", src)
    if m:
        fail("sdc-constrains-vendor-cut-path",
             f"{m.group(0)} is called, but the dcfifo megafunction already "
             "false-paths rdptr_g -> ws_dgrp and delayed_wrptr_g -> rs_dgwp "
             "itself (Info 332165/332166, twenty of them in this design). "
             "Anything added there has no path to attach to and is dropped "
             "with 332182, which reads like a broken pattern and is not",
             "three rounds of pattern fixes for a crossing that needed "
             "nothing; the check is one get_timing_paths query")

    # 7. Every block that walks instances must say how many it bound, and
    #    zero must be loud. A block that quietly constrains nothing is
    #    indistinguishable from one that works.
    for var in re.findall(r"incr\s+(\w+_done)\b", src):
        if not re.search(rf"\${var}\s*==\s*0|\${var}\s*>", src):
            fail("sdc-unchecked-count",
                 f"${var} counts bound instances but nothing checks it for zero",
                 "160 vendor constraints were dropped unnoticed for weeks")
            break


def check_handshake_pairs_are_crossings():
    """Every handshake pair in the SDC must actually cross a clock domain.

    Twice I nearly deleted a correct constraint after concluding "there is no
    crossing here" -- once because get_timing_paths returned nothing, once
    because the destination looked like a port. Both times the code settled
    it: source_holding is clocked by the instance's source_clock and the
    consumer by its dest_clock, so the crossing was real and the constraint
    had to stay.

    The reverse mistake is just as easy: constraining two registers that live
    in the same domain, which is a no-op dressed up as diligence.

    So read the instantiation and compare. A pair whose two ends resolve to
    the same clock is reported; so is one whose instance cannot be found,
    because that means the pattern names something that is not there.
    """
    if not SDC.exists():
        return
    src = code_only(SDC.read_text())

    m = re.search(r"set hs_pairs \[list(.*?)\]\s*\n", src, re.S)
    if not m:
        return

    # Where the handshake instances live, so their clocks can be read.
    vhdl = {}
    for d in ("hdl/fpga/ip/nuand", "hdl/fpga/platforms/bladerf-micro/vhdl",
              "hdl/fpga/platforms/common/bladerf/vhdl"):
        for f in (ROOT / d).rglob("*.vhd"):
            vhdl[f.name] = f.read_text()

    def clocks_of(instance):
        """source_clock and dest_clock of a named handshake instantiation."""
        for body in vhdl.values():
            i = body.find(f"{instance} : entity work.handshake")
            if i < 0:
                i = body.find(f"{instance}: entity work.handshake")
            if i < 0:
                continue
            block = body[i:i + 1200]
            s = re.search(r"source_clock\s*=>\s*(\w+)", block)
            d = re.search(r"dest_clock\s*=>\s*(\w+)", block)
            if s and d:
                return s.group(1), d.group(1)
        return None

    # Two forms occur: "handshake:U_current|source_holding" where the entity
    # is named, and "*U_handshake_timestamp|source_holding" where it is not.
    insts = set(re.findall(r"[|:](U_\w+)\|source_holding", m.group(1)))
    for inst in sorted(insts):
        ck = clocks_of(inst)
        if ck is None:
            fail("sdc-handshake-instance-not-found",
                 f"{inst} is named in hs_pairs but no handshake "
                 "instantiation by that name exists in the VHDL",
                 "constraints for absent logic match nothing and say nothing")
            return
        if ck[0] == ck[1]:
            fail("sdc-handshake-not-a-crossing",
                 f"{inst}: source_clock and dest_clock are both {ck[0]}, so "
                 "this pair does not cross a domain and needs no exception",
                 "a no-op constraint reads as diligence and hides the real ones")
            return


# --------------------------------------------------------------- VHDL rules

def check_vhdl():
    if not HOSTED.exists():
        return
    raw = HOSTED.read_text()

    # 7. Raw rx_/tx_ signals packed into a word read from another domain.
    #    Reads fine as VHDL; nothing in the line says which domain either
    #    side is in.
    target = re.compile(r"^\s*(\w*(?:status|state)\w*)\s*\(", re.I)
    rawsig = re.compile(r"\b((?:rx|tx)_\w+)\b")

    def derived_locally(name):
        for line in raw.split("\n"):
            if "<=" not in line:
                continue
            lhs, rhs = line.split("<=", 1)
            if lhs.strip() != name:
                continue
            deps = rawsig.findall(rhs)
            return bool(deps) and all(
                d.endswith("_sys") or d.endswith("_sync") for d in deps)
        return False

    for line in raw.split("\n"):
        code = line.split("--")[0]
        if "<=" not in code:
            continue
        m = target.match(code)
        if not m:
            continue
        rhs = code.split("<=", 1)[1]
        bad = [n for n in rawsig.findall(rhs)
               if not (n.endswith("_sys") or n.endswith("_sync"))
               and not derived_locally(n)]
        if bad:
            fail("vhdl-raw-cdc-in-status",
                 f"{m.group(1)}: {', '.join(sorted(set(bad)))} reach a "
                 "cross-domain word without a synchroniser",
                 "30 of 32 bits crossed uncrossed; found as a -7.168 ns path")
            break

    # 8. Sequential overrides after a case statement. Each one stacks another
    #    multiplexer on the next-state logic, and the LAST one silently wins,
    #    which is rarely the intended priority.
    for f in (ROOT / "hdl/fpga/ip/nuand/synthesis").glob("fifo_*.vhd"):
        body = f.read_text()
        # Two `if ... then` blocks assigning the same record's state, back to
        # back, with no elsif between them.
        seq = re.compile(
            r"\n(\s*)if\([^\n]*\)\s*then\n(?:[^\n]*\n)*?\1end if;\n+"
            r"\1if\([^\n]*\)\s*then\n(?:[^\n]*\n)*?\1(?:end if;)",
            re.M)
        for m in seq.finditer(body):
            block = m.group(0)
            # Two blocks in DIFFERENT processes are not stacked overrides.
            # The first version of this rule matched the tail of one process
            # against the head of the next and reported a defect that was not
            # there -- a guard that cries wolf teaches people to ignore it.
            if re.search(r"\bend process\b|\bprocess\s*\(", block):
                continue
            if block.count(".state") >= 2 or block.count("_FSM_RESET_VALUE") >= 1:
                if ".state" in block or "RESET_VALUE" in block:
                    line_no = body[:m.start()].count("\n") + 2
                    fail("vhdl-stacked-fsm-override",
                         f"{f.name}:{line_no}: two back-to-back if blocks "
                         "both assign the next FSM state; use one elsif "
                         "chain so the priority is stated and the logic "
                         "stays one level deep",
                         "-0.164 ns setup, and the disable clause silently "
                         "overrode the abort")
                    break
        else:
            continue
        break

    # 9. Two domains ORed combinationally have no owning domain at all, so no
    #    synchroniser can be attached to the result.
    for line in raw.split("\n"):
        code = line.split("--")[0]
        if "<=" not in code:
            continue
        rhs = code.split("<=", 1)[1]
        if re.search(r"\btx_\w+\s+or\s+rx_\w+|\brx_\w+\s+or\s+tx_\w+", rhs):
            fail("vhdl-cross-domain-or",
                 f"{code.strip()}: an OR of two clock domains owns neither",
                 "two status bits had to be deleted outright")
            break


# ------------------------------------------------------------- header rules

def check_headers():
    # 9. A wildcard inside a C block comment: "U_sync_tx_*/U_sync_rx_*"
    #    contains */ and ends the comment, so the rest becomes code.
    for h in HEADERS:
        text = h.read_text()
        depth = 0
        for i, line in enumerate(text.split("\n"), 1):
            j = 0
            while j < len(line) - 1:
                two = line[j:j + 2]
                if two == "/*" and depth == 0:
                    depth = 1
                    j += 2
                    continue
                if two == "*/" and depth == 1:
                    # A comment terminator immediately after a wildcard is
                    # almost always an accident.
                    if j > 0 and line[j - 1] == "*" and not line[:j].strip().endswith("*"):
                        pass
                    depth = 0
                    j += 2
                    continue
                j += 1
        if re.search(r"[A-Za-z_]\*/[A-Za-z_]", text):
            fail("header-wildcard-ends-comment",
                 f"{h.name}: a '*/' inside prose ends the block comment and "
                 "the rest of the sentence becomes code",
                 "libad936x stopped compiling; the build never reached timing")


# NOT a rule: checking SDC node names against hostedxA4.fit.rpt.
#
# Tried, and withdrawn after measuring. The fitter report is not a register
# inventory -- snap_time and current_time_q are both real registers in
# time_tamer and neither appears in it, while ad_iqcor appears 672 times
# despite living in the Qsys system rather than bladerf-hosted.vhd. A rule
# built on it produces confident, wrong findings.
#
# The right source for "does this node exist" is a live query against the
# fitted netlist (get_keepers in quartus_sta), which needs Quartus and so
# does not belong in a one-second static check. qgate's CDC inventory counts
# cover the same ground from the other side: a pattern that matches nothing
# shows up as a class binding fewer instances than expected.


RULES = """
sdc-fatal-message          post_message -type error aborts read_sdc entirely
sdc-unpinned-pair          both ends wildcarded, spans instances, binds to nothing
sdc-false-path-on-bundle   false path drops the skew bound on the same pair
sdc-source-only-relaxation -from without -to reaches past the crossing
sdc-regexp-on-hierarchy    backslashes in hierarchy names defeat Tcl regexp
sdc-unchecked-count        a block that binds zero instances says nothing
vhdl-stacked-fsm-override  two if blocks both assigning next state; last wins
vhdl-raw-cdc-in-status     rx_/tx_ signals in a word read by another domain
vhdl-cross-domain-or       an OR of two domains has no owning domain
header-wildcard-ends-comment  '*/' in prose ends the comment, prose becomes code
"""


def main():
    if "--list" in sys.argv:
        print(RULES.strip())
        return 0

    check_all_sdcs()
    check_handshake_pairs_are_crossings()
    check_sdc()
    check_vhdl()
    check_headers()

    if not findings:
        print("qcheck: clean")
        return 0

    for rule, detail, cost in findings:
        print(f"FAIL  {rule}")
        print(f"      {detail}")
        print(f"      cost: {cost}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
