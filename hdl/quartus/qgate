#!/usr/bin/env bash
#
# Release gate for a Quartus build log.
#
#   qgate <logfile>          exit 0 if the build is acceptable, 1 if not
#   qgate <logfile> --warn   report but always exit 0
#
# Exists because a build can report "successful" while the constraints you
# wrote never bound to anything. That happened here: 160 vendor DCFIFO
# constraints were dropped with "contains zero elements" for weeks. The
# compile was green, the timing summary was green, and the gray-code pointer
# crossings of all five datapath FIFOs were unconstrained the whole time.
#
# A timing conclusion is only worth as much as the SDC that produced it, so
# these are failures, not warnings:
#
#   Ignored <assignment>          the constraint parsed and matched nothing
#   contains zero elements        the collection was empty
#   No path is found              endpoints exist, no path between them
#
# Those last two are different failures and both matter. A guard of the form
#   if {[get_collection_size $from] > 0 && [get_collection_size $to] > 0}
# only proves the collections are non-empty; it says nothing about whether a
# path runs between them. The dcfifo pointer crossings passed that guard and
# still bound to nothing, because the destination pattern used "|" where the
# hierarchy has ":" -- it matched a different, real set of registers. Hence
# "no path for assignment" is a hard failure here, not a warning.
#   Invalid                       in report_exceptions
#   Critical Warning / Error      anything Quartus itself calls serious
#
# Known-acceptable cases are listed in WAIVED below, each with a reason.
set -uo pipefail

f="${1:?usage: qgate <logfile> [--warn]}"
mode="${2:-}"
[ -r "$f" ] || { echo "qgate: cannot read $f" >&2; exit 2; }

fail=0
note() { printf '%-6s %s\n' "$1" "$2"; }

# Patterns that are expected and understood. Keep the reason with the
# pattern: a waiver without one is just a silenced failure.
WAIVED=(
    # Skew from a generated pin clock to its own output pin: the clock is
    # the pin, so there is no internal path to bound. From spi.sdc/i2c.sdc,
    # predates this work.
    'set_max_skew -from \[get_clocks \{(adf|adi|dac|pwr)_[a-z]*_pin\}\]'
)

waived() {
    local line="$1" p
    for p in "${WAIVED[@]}"; do
        [[ "$line" =~ $p ]] && return 0
    done
    return 1
}

check() {
    local label="$1" pattern="$2" n=0
    while IFS= read -r line; do
        waived "$line" && continue
        n=$((n + 1))
        [ "$n" -le 3 ] && note "" "$(echo "$line" | sed 's/^\s*//' | cut -c1-110)"
    done < <(grep -E "$pattern" "$f" 2>/dev/null)
    if [ "$n" -gt 0 ]; then
        note FAIL "$label: $n"
        fail=1
    else
        note ok "$label"
    fi
}

require_evidence() {
    local label="$1" pattern="$2"
    if grep -qE "$pattern" "$f" 2>/dev/null; then
        note ok "$label"
    else
        note FAIL "$label: required evidence missing"
        fail=1
    fi
}

echo "qgate $(basename "$f")"

# Did the build run at all? Every other check below looks for something bad
# in the log, so a log that stops early passes all of them. build_bladerf.sh
# exits 0 when Quartus is not in PATH ("does not appear to be in your PATH")
# and a killed background job leaves a truncated log with the same status --
# both happened on 2026-09-10 and both looked like clean builds.
if grep -qE 'does not appear to be in your PATH' "$f"; then
    note FAIL "build never started: Quartus not in PATH (use ~/soft/q25)"
    fail=1
elif ! grep -qE 'Quartus Prime (Fitter|Timing Analyzer) was successful' "$f"; then
    note FAIL "build did not finish: no Fitter/STA success line in log"
    fail=1
else
    note ok "build completed"
fi

check "errors"                 '^\s*Error'
check "constraints ignored"    'Ignored (set_|filter)'
check "empty collections"      'contains zero elements'
check "no path for assignment" 'No path is found satisfying'
# An exception the analyser accepted but could not apply is the same class of
# defect as one that matched nothing: the intent is recorded and not enforced.
check "invalid exceptions"     'Invalid (set_|timing)|exception is invalid'
# Unconstrained paths are how a whole crossing avoids analysis without any
# constraint being wrong. Two separate regressions here were only visible as
# a slack number, never as a message, so count them explicitly.
check "unconstrained paths"    'Unconstrained [A-Za-z ]*Paths? *: *[1-9]'
# The most dangerous one, and the reason this line exists. A failure while
# reading the SDC throws away every constraint after the failure point -- but
# the fitter carries on, produces a .rbf and writes a timing summary. One
# build reported "Can't fit design" with ALMs at 55% and M10K at 90%, neither
# full, because read_sdc had aborted and the fitter was working without the
# constraints. A green fit and a written bitstream are therefore not evidence
# that the intended timing model was ever applied.
check "sdc read failed"        'Read_sdc failed|error.*reading.*SDC|Evaluation of Tcl script.*sdc'
# A skew or delay bound that was accepted and then dropped leaves a multi-bit
# crossing physically unbounded while the file still claims otherwise.
check "physical bound ignored" 'No destination clock period was found'

# CDC inventory. The SDC prints how many instances each crossing class bound;
# these are the numbers a known-good build reports. A change is not
# automatically wrong -- adding a FIFO legitimately moves one -- but it must
# be noticed and re-approved rather than drifting.
#
# Every number here was once wrong and silent. The dcfifo pointers bound zero
# instances for weeks while the file looked correct.
expect_count() {
    local label="$1" pattern="$2" want="$3"
    local got
    got=$(grep -oE "$pattern" "$f" 2>/dev/null | grep -oE '[0-9]+' | tail -1)
    if [ -z "$got" ]; then
        note FAIL "$label: never reported (the SDC block did not run)"
        fail=1
    elif [ "$got" != "$want" ]; then
        note FAIL "$label: $got, expected $want"
        fail=1
    else
        note ok "$label: $got"
    fi
}

# These counts are structural, not device-dependent: they count instances of
# time_tamer, handshake and dcfifo in the hosted RTL, which is the same design
# on xA4 and on xA9. A bigger part changes how much fits, not how many
# crossings exist. If one of these ever differs between sizes, that means the
# revision instantiates something conditionally and the difference is the news.
#
# The handshake count differs by revision. Sweep currently has 15 constrained
# pairs: the hosted crossings plus dwell config, RX epoch control/status and
# timestamps, pre-trigger address bundled-data crossing, and runtime RX status
# monitor. Keeping this count exact makes a newly added or dropped CDC pair
# visible to qgate.
if grep -qiE 'revision([[:space:]]+name)?[[:space:]]*[:=][[:space:]]*sweep|revision sweep' "$f" 2>/dev/null; then
    hs_expect=15
else
    hs_expect=5
fi
expect_count "cdc tamer compare payload"  'tamer compare payload crossing constrained on [0-9]+' 2
expect_count "cdc handshake"        'handshake crossings constrained: [0-9]+'        "$hs_expect"
expect_count "ADI up_xfer bundled data" 'ADI up_xfer bundled crossings constrained: [0-9]+' 9
expect_count "cdc dcfifo pointers"  'dcfifo pointer crossings constrained on [0-9]+' 10

# Timing: any negative slack in the summary is a failure. Resolve the exact
# revision's STA summary from Quartus's Project Name and Revision Name in the
# build log. Logs are often stored in /tmp; searching their parent (or /) can
# select an unrelated stale report and makes qgate traverse the whole tree.
sta=$(grep -oE '/[^ ]*\.sta\.summary' "$f" 2>/dev/null | head -1)
if [ -n "$sta" ] && [ ! -r "$sta" ]; then
    sta=""
fi
project=$(sed -nE 's/.*Project( Name)?[[:space:]]*[:=][[:space:]]*([^[:space:]]+).*/\2/p' "$f" 2>/dev/null | head -1)
revision=$(sed -nE 's/.*Revision( Name)?[[:space:]]*[:=][[:space:]]*([^[:space:]]+).*/\2/p' "$f" 2>/dev/null | head -1)
if [ -z "$revision" ]; then
    revision=$(sed -nE 's/.*Revision[[:space:]]+([^[:space:]]+).*/\1/p' "$f" 2>/dev/null | head -1)
fi
if [ -z "$sta" ] && [ -n "$project" ] && [ -n "$revision" ]; then
    project_dir=$(dirname "$project")
    candidate="$project_dir/output_files/$revision.sta.summary"
    if [ -r "$candidate" ]; then
        sta="$candidate"
    fi
fi
if [ -z "$sta" ] && [ -n "$revision" ]; then
    project_work=$(grep -oE '/[^[:space:]\"]*/work/bladerf-[^/[:space:]\"]+' "$f" 2>/dev/null | head -1)
    if [ -n "$project_work" ]; then
        candidate="$project_work/output_files/$revision.sta.summary"
        if [ -r "$candidate" ]; then
            sta="$candidate"
        fi
    fi
fi
if [ -z "$sta" ] && [ -n "$revision" ]; then
    log_dir=$(cd "$(dirname "$f")" && pwd)
    for project_work in "$log_dir"/../work/bladerf-* "$log_dir"/work/bladerf-*; do
        candidate="$project_work/output_files/$revision.sta.summary"
        if [ -r "$candidate" ]; then
            sta="$candidate"
            break
        fi
    done
fi
if [ -z "$sta" ] && [ -n "$revision" ]; then
    log_dir=$(dirname "$f")
    for candidate in "$log_dir/$revision.sta.summary" \
                     "$log_dir/output_files/$revision.sta.summary"; do
        if [ -r "$candidate" ]; then
            sta="$candidate"
            break
        fi
    done
fi
if [ -n "${sta:-}" ] && [ -r "$sta" ]; then
    neg=$(grep -A1 '^Type' "$sta" | grep -cE '^Slack\s*:\s*-' || true)
    if [ "${neg:-0}" -gt 0 ]; then
        note FAIL "negative slack entries: $neg"
        fail=1
    else
        note ok "timing (no negative slack)"
    fi
else
    note FAIL "timing summary not found, timing not checked"
    fail=1
fi

# A positive setup/hold summary does not prove that bundled-data max-skew
# constraints met their bound. The sweep full flow appends the persistent
# report_adc_xfer_cdc.tcl output; require all four fitted RX lanes and zero
# violated max-skew paths from that same build.
if grep -qiE 'revision([[:space:]]+name)?[[:space:]]*[:=][[:space:]]*sweep|revision sweep' "$f" 2>/dev/null; then
    if ! grep -q 'ADC_XFER all four RX bundles paired: PASS' "$f"; then
        note FAIL "max-skew report missing or RX bundle inventory incomplete"
        fail=1
    else
        skew_summary=$(grep -E 'Report Max Skew: Found [0-9]+ paths? \([0-9]+ violated\)' "$f" | tail -1)
        if [ -z "$skew_summary" ]; then
            note FAIL "max-skew summary missing from sweep build log"
            fail=1
        elif [[ "$skew_summary" =~ \(([1-9][0-9]*)[[:space:]]+violated\) ]]; then
            note FAIL "max-skew violations: ${BASH_REMATCH[1]}"
            fail=1
        else
            note ok "max-skew (all paths within bound)"
        fi
    fi
    require_evidence "ADI up_xfer bundles" '^ADI_XFER bundles paired: 9/9$'
    require_evidence "clock monitor bundles" '^CLOCK_MON bundles paired: 2/2$'
    require_evidence "ADI XFER status bundles" '^XFER_STATUS bundles paired: 6/6$'
fi

# STA alone misses CDC structures. Require the Design Assistant report for the
# exact same revision and reject unresolved High/Critical violations. In
# particular, keep D101 bundled crossings and D103 sticky-fault crossings
# visible until each class has implementation evidence; never blanket-waive.
drc_report=""
if [ -n "${sta:-}" ]; then
    drc_report="${sta%.sta.summary}.drc.rpt"
fi
if [ -z "$drc_report" ] || [ ! -r "$drc_report" ]; then
    note FAIL "Design Assistant report not found for this revision"
    fail=1
elif [ "$drc_report" -ot "$sta" ]; then
    note FAIL "Design Assistant report predates this STA build"
    fail=1
else
    drc_value() {
        awk -F';' -v key="$1" '$2 ~ key {gsub(/[[:space:]]/, "", $3); print $3; exit}' "$drc_report"
    }
    drc_critical=$(drc_value "Total Critical Violations")
    drc_high=$(drc_value "Total High Violations")
    drc_c105=$(drc_value "- Rule C105")
    drc_d101=$(drc_value "- Rule D101")
    drc_d103=$(drc_value "- Rule D103")
    drc_c105=${drc_c105:-0}
    drc_d101=${drc_d101:-0}
    drc_d103=${drc_d103:-0}
    if ! grep -qE 'Design Assistant Status[[:space:]]*;[[:space:]]*Analyzed' "$drc_report" ||
       ! [[ "$drc_critical" =~ ^[0-9]+$ && "$drc_high" =~ ^[0-9]+$ ]]; then
        note FAIL "Design Assistant report incomplete or malformed"
        fail=1
    else
        d101_dispositioned=0
        c105_dispositioned=0
        c105_node=$(awk -F';' '$2 ~ /Rule C105:/ && $3 ~ /altera_internal_jtag/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); print $3; exit}' "$drc_report")
        if [ "$drc_c105" = 1 ] && [ "$c105_node" = "altera_internal_jtag~TCKUTAP" ]; then
            c105_dispositioned=1
        fi
        if [ "$drc_critical" = 0 ] && [ "$c105_dispositioned" = 1 ] &&
           [ "$drc_d101" = 724 ] && [ "$drc_d103" = 0 ] &&
           [ "$drc_high" = "$((drc_d101 + drc_c105))" ]; then
            classifier="$(dirname "$0")/classify_d101.py"
            if d101_inventory=$(python3 "$classifier" "$drc_report" 2>&1); then
                if grep -q '^D101 category adi-clock-monitor: 64$' <<<"$d101_inventory" &&
                   grep -q '^D101 category adi-up-xfer: 129$' <<<"$d101_inventory" &&
                   grep -q '^D101 category adi-xfer-status: 10$' <<<"$d101_inventory" &&
                   grep -q '^D101 category held-handshake: 393$' <<<"$d101_inventory" &&
                   grep -q '^D101 category tamer-payload: 128$' <<<"$d101_inventory"; then
                    d101_dispositioned=1
                    note ok "Design Assistant D101: all 724 sources classified; fitted CDC bounds required above"
                    note ok "Design Assistant C105: exact internal JTAG TCK finding dispositioned outside RF datapath"
                fi
            fi
        fi
        if [ "$d101_dispositioned" != 1 ]; then
            if [ "$drc_critical" != 0 ] || [ "$drc_high" != 0 ]; then
                note FAIL "Design Assistant violations: critical=$drc_critical high=$drc_high C105=$drc_c105 D101=$drc_d101 D103=$drc_d103"
                fail=1
            else
                note ok "Design Assistant (zero critical/high violations)"
            fi
        fi
    fi
fi

# D101 is only dispositioned when every fitted source maps to the exact
# bundled-data inventory above: 393 held handshakes, 128 tamer payloads, and
# all ADI control/status/clock snapshots. The single C105 disposition is bound
# to the exact internal JTAG TCK node; any other C105 endpoint/count still
# fails. Other critical warnings remain fatal.
critical_count=0
while IFS= read -r line; do
    if [ "${d101_dispositioned:-0}" = 1 ]; then
        if [[ "$line" =~ Critical\ Warning\ \(308060\):.*Rule\ D101 ]]; then
            continue
        fi
        if [ "${c105_dispositioned:-0}" = 1 ] &&
           [[ "$line" =~ Critical\ Warning\ \(308042\):.*Rule\ C105 ]]; then
            continue
        fi
        if [[ "$line" =~ Critical\ Warning\ \(308012\):\ Node ]] &&
           [[ "$line" =~ (handshake:|time_tamer:|compare_payload|up_xfer_cntrl:|up_xfer_status:|up_clock_mon:) ]]; then
            continue
        fi
        if [ "${c105_dispositioned:-0}" = 1 ] &&
           [[ "$line" =~ Critical\ Warning\ \(308012\):\ Node.*altera_internal_jtag~TCKUTAP ]]; then
            continue
        fi
    fi
    critical_count=$((critical_count + 1))
    [ "$critical_count" -le 3 ] && note "" "$(echo "$line" | sed 's/^\s*//' | cut -c1-110)"
done < <(grep -E '^\s*Critical Warning' "$f" 2>/dev/null)
if [ "$critical_count" -gt 0 ]; then
    note FAIL "critical warnings: $critical_count"
    fail=1
elif [ "${d101_dispositioned:-0}" = 1 ]; then
    note ok "critical warnings (D101 and exact internal-JTAG C105 dispositioned; no others)"
else
    note ok "critical warnings"
fi

if [ "$mode" = "--warn" ]; then
    exit 0
fi
exit "$fail"
