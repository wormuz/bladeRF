# Keep Quartus and NIOS II tools available in every shell opened in this repo.
# Override ALTERA_ROOT when using a different local Quartus installation.
_repo_root="${DIRENV_DIR:-$(pwd)}"
_release_cli="${_repo_root}/host/build-release-qualification/output"
if [[ -x "${_release_cli}/bladeRF-cli" ]]; then
  PATH_add "${_release_cli}"
fi
_altera_root="${ALTERA_ROOT:-${HOME}/altera/25.1std}"
if [[ ! -x "${_altera_root}/quartus/bin/quartus_sh" ]]; then
  for _candidate in "${HOME}/altera/25.1std" "${HOME}/soft/quartus-23.1"; do
    if [[ -x "${_candidate}/quartus/bin/quartus_sh" ]]; then
      _altera_root="${_candidate}"
      break
    fi
  done
fi
if [[ -x "${_altera_root}/quartus/bin/quartus_sh" ]]; then
  export ALTERA_ROOT="${_altera_root}"
  export QUARTUS_ROOTDIR="${_altera_root}/quartus"
  export NIOS2EDS_ROOT="${_altera_root}/nios2eds"
  export SOPC_KIT_NIOS2="${_altera_root}/nios2eds"
  PATH_add "${_altera_root}/quartus/bin"
  PATH_add "${_altera_root}/quartus/sopc_builder/bin"
  PATH_add "${_altera_root}/nios2eds/bin"
  PATH_add "${_altera_root}/nios2eds/sdk2/bin"
  PATH_add "${_altera_root}/nios2eds"
  PATH_add "${_altera_root}/nios2eds/bin/gnu/H-x86_64-pc-linux-gnu/bin"
else
  log_error "Quartus not found; set ALTERA_ROOT to the installation root"
fi
unset _repo_root _release_cli _altera_root _candidate
